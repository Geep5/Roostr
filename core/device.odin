package core

// Device records: one personal object per device of the account (no
// `channel`: the personal stream, never shared with a space), under the
// fixed id `__device__:<deviceId>` (the device id the directories' counts
// are kept under: the daemon's <data>/device-id, a replica's
// roostr-device-id). Settings lists them ("Your devices"). Fields:
//   name         String  shown name; auto-generated by the device
//   name_custom  Bool    a person renamed it: the auto name never replaces it
//   kind         String  "engine" | "browser" | "iphone" | "desktop"
//   holding      String  "full" | "lite"
//   percent      Int     0-100, about how much of the vault it holds
//   last_seen    Int     epoch ms of its last write
// Each device writes only its own record (`device_seen`), so devices never
// collide in the DAG. Removing a record (`delete`) is undone by its device
// the next time it runs.

import "core:encoding/json"
import "core:slice"
import "core:strings"

DEVICE_TYPE :: "device"
DEVICE_ID_PREFIX :: "__device__:"
// last_seen alone is refreshed at most this often: a running device keeps
// its record current without churning the change log.
DEVICE_SEEN_MS :: 30 * 60 * 1000
DEVICE_KINDS :: []string{"engine", "browser", "iphone", "desktop"}
DEVICE_HOLDINGS :: []string{"full", "lite"}

is_device_id :: proc(id: string) -> bool {
	return len(id) > len(DEVICE_ID_PREFIX) && id[:len(DEVICE_ID_PREFIX)] == DEVICE_ID_PREFIX
}

@(private = "file")
device_int :: proc(fields: [dynamic]Value_Entry, key: string) -> (i64, bool) {
	v, ok := fields_get(fields, key)
	if !ok || v.kind != .Int do return 0, false
	return v.i, true
}

/**
 * What `device_seen` writes on `stored` (the record as held, nil when
 * absent): a missing, binned or retyped record is (re)created whole; else
 * only the fields that differ, the auto name only while nobody renamed it,
 * and last_seen with any of them or once DEVICE_SEEN_MS has passed. Empty
 * when nothing is due.
 */
device_seen_ops :: proc(stored: ^Object_State, name, kind, holding: string, percent, now: i64) -> [dynamic]Operation {
	ops := make([dynamic]Operation, context.temp_allocator)
	live := stored != nil && !stored.deleted && stored.type_key == DEVICE_TYPE
	empty: [dynamic]Value_Entry
	fields := stored != nil ? stored.fields : empty
	if !live do append(&ops, Operation{kind = .Object_Create, type_key = DEVICE_TYPE})
	custom, has_custom := fields_get(fields, "name_custom")
	renamed := has_custom && custom.kind == .Bool && custom.b
	if !renamed && field_string(fields, "name") != name do append(&ops, Operation{kind = .Field_Set, key = "name", value = string_value(name)})
	if !has_custom do append(&ops, Operation{kind = .Field_Set, key = "name_custom", value = bool_value(false)})
	if field_string(fields, "kind") != kind do append(&ops, Operation{kind = .Field_Set, key = "kind", value = string_value(kind)})
	if field_string(fields, "holding") != holding do append(&ops, Operation{kind = .Field_Set, key = "holding", value = string_value(holding)})
	if held, ok := device_int(fields, "percent"); !ok || held != percent do append(&ops, Operation{kind = .Field_Set, key = "percent", value = int_value(percent)})
	seen, has_seen := device_int(fields, "last_seen")
	if len(ops) > 0 || !has_seen || abs(now - seen) >= DEVICE_SEEN_MS {
		append(&ops, Operation{kind = .Field_Set, key = "last_seen", value = int_value(now)})
	}
	return ops
}

/** The `device_seen` action: validate, then plan this device's record (result `changed`). */
device_seen_plan :: proc(plan: ^Mutation_Plan, input: Mutation_Input, parsed: json.Value) -> string {
	object_id := json_str(parsed, "object_id")
	if !is_device_id(object_id) do return "object_id must be __device__:<deviceId>"
	name := strings.trim_space(json_str(parsed, "name"))
	if name == "" do return "name required"
	kind := json_str(parsed, "kind")
	if !slice.contains(DEVICE_KINDS, kind) do return "kind must be engine, browser, iphone or desktop"
	holding := json_str(parsed, "holding")
	if !slice.contains(DEVICE_HOLDINGS, holding) do return "holding must be full or lite"
	percent, has_percent := json_int(parsed, "percent")
	if !has_percent || percent < 0 || percent > 100 do return "percent must be 0-100"
	ops := device_seen_ops(input.states[object_id], name, kind, holding, percent, input.timestamp)
	if len(ops) > 0 do mutation_add(plan, input, object_id, ops[:])
	plan.result["changed"] = json.Boolean(len(ops) > 0)
	return ""
}

/** The `device_rename` action: a person's name for a device record, kept over the auto name. */
device_rename_plan :: proc(plan: ^Mutation_Plan, input: Mutation_Input, parsed: json.Value) -> string {
	object_id := json_str(parsed, "object_id")
	name := strings.trim_space(json_str(parsed, "name"))
	if name == "" do return "name required"
	s := input.states[object_id]
	if s == nil || s.deleted || s.type_key != DEVICE_TYPE do return "unknown device"
	mutation_add(plan, input, object_id, {
		Operation{kind = .Field_Set, key = "name", value = string_value(name)},
		Operation{kind = .Field_Set, key = "name_custom", value = bool_value(true)},
	})
	return ""
}
